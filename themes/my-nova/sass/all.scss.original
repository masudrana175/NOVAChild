:root {
  --beauty-main-bg-color:#841853;
  --hair-main-bg-color:#ef5b5b;
  --medical-main-bg-color:#30d9b7;
  --beauty-second-bg-color:#9e2965;
  --hair-second-bg-color:#f16f6f;
  --medical-second-bg-color:#3edbb8;
  --main-text-color-grey:#525252;
}

body {
  font-family: Poppins, sans-serif;

  .productbox-price, #footer .productlist-filter-headline {
    font-family: Poppins, sans-serif;
  }

  &[color-theme="1200"] a:hover {
    color: var(--beauty-main-bg-color);
  }

  &[color-theme="1201"] a:hover {
    color: var(--medical-main-bg-color);
  }

  &[color-theme="1202"] a:hover {
    color: var(--hair-main-bg-color);
  }

  &[color-theme="1200"] aside .nav-panel > .nav > .active > .nav-link {
    border-bottom: 0.375rem solid var(--beauty-main-bg-color);
  }

  &[color-theme="1201"] aside .nav-panel > .nav > .active > .nav-link {
    border-bottom: 0.375rem solid var(--medical-main-bg-color);
  }

  &[color-theme="1202"] aside .nav-panel > .nav > .active > .nav-link {
    border-bottom: 0.375rem solid var(--hair-main-bg-color);
  }

  &[color-theme="1200"] .btn-link:hover {
    color: var(--beauty-main-bg-color);
  }

  &[color-theme="1201"] .btn-link:hover {
    color: #30d9b7;
  }

  &[color-theme="1202"] .btn-link:hover {
    color: #ef5b5b;
  }

  &[color-theme="1200"] .first-layer-menu-list .nav-item.active {
    background-color: var(--beauty-main-bg-color);
    color: #fff;
  }

  .first-layer-menu-list .nav-item {
    &.active a {
      color: #fff;
    }

    a {
      text-transform: uppercase;
      font-weight: 700;
    }
  }

  &[color-theme="1202"] .first-layer-menu-list .nav-item.active {
    background-color: var(--hair-main-bg-color);
    color: #fff;
  }

  &[color-theme="1201"] .first-layer-menu-list .nav-item.active {
    background-color: #30d9b7;
    color: #fff;
  }

  &[color-theme="1200"] {
    .nav-link:hover:not(.dropdown-item):not(.btn) {
      color: var(--beauty-main-bg-color);
    }

    header .navbar-nav > .nav-item > .nav-link::before {
      border-color: var(--beauty-main-bg-color);
    }
  }

  &[color-theme="1201"] {
    .nav-link:hover:not(.dropdown-item):not(.btn) {
      color: #30d9b7;
    }

    header .navbar-nav > .nav-item > .nav-link::before {
      border-color: #30d9b7;
    }
  }

  &[color-theme="1202"] {
    .nav-link:hover:not(.dropdown-item):not(.btn) {
      color: var(--hair-main-bg-color);
    }

    header .navbar-nav > .nav-item > .nav-link::before {
      border-color: var(--hair-main-bg-color);
    }
  }

  &[color-theme="1200"] .noUi-horizontal {
    .noUi-connect {
      background-color: var(--beauty-main-bg-color);
    }

    .noUi-handle {
      background: var(--beauty-main-bg-color);
      box-shadow: 0 0 0 5px rgba(200, 121, 156, 0.5);
    }
  }

  &[color-theme="1201"] .noUi-horizontal {
    .noUi-connect {
      background-color: #30d9b7;
    }

    .noUi-handle {
      background: #30d9b7;
      box-shadow: 0 0 0 5px rgba(48, 217, 183, 0.5);
    }
  }

  &[color-theme="1202"] .noUi-horizontal {
    .noUi-connect {
      background-color: var(--hair-main-bg-color);
    }

    .noUi-handle {
      background: var(--hair-main-bg-color);
      box-shadow: 0 0 0 5px rgba(239, 91, 91, 0.5);
    }
  }
}

#footer #social-media-wrapper .btn-icon-beautek {
  border-color: transparent;
  color: #fff;

  &:hover {
    color: var(--beauty-main-bg-color);
  }
}

.navbar-nav .dropdown-menu.show {
  position: absolute;
}

.offcanvas-first-layer .first-layer-menu-list {
  list-style: none;
  padding-left: 0;
}

.shop-first-layer-navigation {
  display: flex;
  align-items: end;

  .first-layer-menu-list {
    display: flex;
    flex-direction: row;
    list-style: none;

    .nav-item.active .nav-link {
      color: #fff !important;
    }
  }
}

header .navbar-nav > .nav-item > .nav-link {
  padding: 0.9rem;
}

footer#footer {
  padding-top: 0;

  .row#footer-top {
    border-bottom: 2px solid white;
    margin-bottom: 25px;
    margin-left: 0;
    margin-right: 0;
    padding: 25px 0;
  }

  .productlist-filter-headline {
    text-transform: uppercase;
    color: #fff;
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }

  .nav-item a {
    color: #fff;
  }

  .footer-beautek-logo {
    max-width: 35px;
    height: auto;
  }
}

